{
  "name": "tasklane",
  "private": true,
  "description": "A small Linear-style issue tracker used in the harness engineering workshop.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta \"npm run dev -w @tasklane/api\" \"npm run dev -w @tasklane/web\"",
    "build": "npm run build -w @tasklane/web",
    "db:seed": "npm run db:seed -w @tasklane/api",
    "db:generate": "npm run db:generate -w @tasklane/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err-long",
    "check": "npm run lint && npm run arch && npm run knip && npm test && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "concurrently": "^9.2.5",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
